<Window
    x:Class="Downlism.App.ExtensionGuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="在瀏覽器裡載入 Downlism">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Padding="28,24,28,8" Spacing="6">
            <TextBlock Text="在瀏覽器裡載入 Downlism" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="裝上之後，Chrome 與 Edge 的下載會自動交給 Downlism，網頁上播放的影片也會被找出來。不裝也能用，只是得自己貼網址。" />
        </StackPanel>

        <!-- Four numbered steps. The path is the only one that cannot be typed from memory, so
             it is the one with buttons beside it. -->
        <StackPanel Grid.Row="1" Padding="28,16,28,20" Spacing="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StepNumberStyle}">
                    <TextBlock Text="1" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock TextWrapping="Wrap" Text="開啟瀏覽器的擴充功能頁面。" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="開啟 Chrome" Click="OpenChromeClick" AutomationProperties.Name="開啟 Chrome 擴充功能頁面" />
                        <Button Content="開啟 Edge" Click="OpenEdgeClick" AutomationProperties.Name="開啟 Edge 擴充功能頁面" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StepNumberStyle}">
                    <TextBlock Text="2" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="打開右上角的「開發人員模式」。" FontWeight="SemiBold" />
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StepNumberStyle}">
                    <TextBlock Text="3" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="按「載入未封裝項目」。" FontWeight="SemiBold" />
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StepNumberStyle}">
                    <TextBlock Text="4" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock TextWrapping="Wrap" Text="選這個資料夾：" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="FolderPath" IsReadOnly="True" FontFamily="Consolas"
                                 AutomationProperties.Name="擴充功能資料夾" />
                        <Button Grid.Column="1" Content="複製" Click="CopyPathClick"
                                AutomationProperties.Name="複製資料夾路徑" />
                        <Button Grid.Column="2" Content="開啟" Click="OpenFolderClick"
                                AutomationProperties.Name="在檔案總管開啟" />
                    </Grid>

                    <TextBlock x:Name="FolderHint" TextWrapping="Wrap" FontSize="11.5" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
            </Grid>

        </StackPanel>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="28,14"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="載入後擴充功能圖示會顯示「已連線」。Firefox 需要官方簽章，目前還不支援。" />

                <Button Grid.Column="1" Content="知道了" Click="CloseClick"
                        Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="關閉" />
            </Grid>
        </Border>
    </Grid>
</Window>
