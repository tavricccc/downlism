<Window
    x:Class="Downlism.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Downlism.App.Controls"
    xmlns:vm="using:Downlism.App.ViewModels"
    Title="Downlism">

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar. Two actions and one setting: everything else belongs on a row. -->
        <Grid Padding="20,16,20,14" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PasteButton" Style="{ThemeResource AccentButtonStyle}" Click="PasteClick"
                    AutomationProperties.Name="貼上網址">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE77F;" />
                    <TextBlock Text="貼上網址" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Content="全部暫停" Click="PauseAllClick" AutomationProperties.Name="全部暫停" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="速度上限" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="SpeedLimit" MinWidth="124" SelectionChanged="SpeedLimitChanged"
                          AutomationProperties.Name="速度上限">
                    <ComboBoxItem Content="不限制" Tag="0" IsSelected="True" />
                    <ComboBoxItem Content="1 MB/s" Tag="1048576" />
                    <ComboBoxItem Content="5 MB/s" Tag="5242880" />
                    <ComboBoxItem Content="20 MB/s" Tag="20971520" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- An empty list is an invitation, not a shrug. -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="10" Padding="40"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <Image Source="ms-appx:///Assets/Downlism.png" Width="56" Height="56" Opacity="0.9"
                   HorizontalAlignment="Center" AutomationProperties.Name="Downlism" />
            <TextBlock Text="還沒有下載" HorizontalAlignment="Center"
                       Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="複製一個下載連結後按上方的貼上網址，或在 Chrome、Edge 裝上 Downlism 擴充功能，之後的下載就會自動交給這裡。" />
        </StackPanel>

        <ListView x:Name="Downloads" Grid.Row="1" SelectionMode="None"
                  Padding="8,0,8,12" ScrollViewer.HorizontalScrollMode="Disabled"
                  AutomationProperties.Name="下載清單">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadRowViewModel">
                    <!-- Hairline separators instead of cards: this is a ledger of transfers,
                         and a grid of bordered boxes would give every row a frame it has not
                         earned. -->
                    <Border BorderThickness="0,0,0,1" Padding="0,0,0,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid RowSpacing="9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Numbers live in fixed right-aligned columns so a row that
                                 updates four times a second never shifts under the cursor. -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind FileName}" />

                                <TextBlock Grid.Column="1" Text="{x:Bind Size, Mode=OneWay}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Speed, Mode=OneWay}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Remaining, Mode=OneWay}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                    <Button Click="PauseClick" Tag="{x:Bind Id}"
                                            Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(CanPause), Mode=OneWay}"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            AutomationProperties.Name="暫停" ToolTipService.ToolTip="暫停">
                                        <FontIcon FontSize="14" Glyph="&#xE769;" />
                                    </Button>
                                    <Button Click="ResumeClick" Tag="{x:Bind Id}"
                                            Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(CanResume), Mode=OneWay}"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            AutomationProperties.Name="繼續" ToolTipService.ToolTip="繼續">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    </Button>
                                    <Button Click="OpenFolderClick" Tag="{x:Bind Id}"
                                            Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(IsFinished), Mode=OneWay}"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            AutomationProperties.Name="開啟位置" ToolTipService.ToolTip="開啟位置">
                                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                                    </Button>
                                    <Button Click="RemoveClick" Tag="{x:Bind Id}"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            AutomationProperties.Name="移除" ToolTipService.ToolTip="從清單移除">
                                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <controls:SegmentRibbon Grid.Row="1"
                                                    Segments="{x:Bind Segments, Mode=OneWay}"
                                                    Fraction="{x:Bind Fraction, Mode=OneWay}"
                                                    Tone="{x:Bind Tone, Mode=OneWay}"
                                                    HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="2" Text="{x:Bind Status, Mode=OneWay}"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="20,0,20,16" />
    </Grid>
</Window>
