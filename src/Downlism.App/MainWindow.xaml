<Window x:Class="Downlism.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Downlism.App.Controls" xmlns:vm="using:Downlism.App.ViewModels" Title="Downlism">
    <Grid x:Name="Root" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" Margin="12,8,12,0">
            <AppBarButton x:Name="PasteButton" Label="貼上網址" Icon="Paste" Click="PasteClick" AutomationProperties.Name="貼上網址"/>
            <AppBarButton Label="影片頁面" Icon="Video" Click="PasteMediaClick" AutomationProperties.Name="貼上影片頁面"/>
            <AppBarButton Label="批次新增" Icon="Add" Click="BatchClick" AutomationProperties.Name="批次新增"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="PauseAllButton" Label="全部暫停" Icon="Pause" Click="PauseAllClick"/>
            <AppBarButton x:Name="ResumeAllButton" Label="全部繼續" Icon="Play" Click="ResumeAllClick"/>
            <AppBarButton Label="設定" Icon="Setting" Click="SettingsClick" AutomationProperties.Name="設定"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="暫停選取" Click="PauseSelectedClick"/>
                <AppBarButton Label="繼續選取" Click="ResumeSelectedClick"/>
                <AppBarButton Label="移除選取（保留檔案）" Click="RemoveSelectedClick"/>
                <AppBarButton Label="複製選取網址" Click="CopySelectedClick"/>
                <AppBarSeparator/>
                <AppBarButton Label="匯入網址清單…" Click="ImportLinksClick"/>
                <AppBarButton Label="匯出目前檢視網址…" Click="ExportLinksClick"/>
                <AppBarButton Label="瀏覽器擴充功能" Click="ExtensionGuideClick"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <Grid Grid.Row="1" Padding="20,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="StatusFilter" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="StatusFilterChanged" AutomationProperties.Name="下載狀態篩選">
                <ComboBoxItem Content="全部下載" Tag="all"/><ComboBoxItem Content="進行中" Tag="active"/>
                <ComboBoxItem Content="已完成" Tag="completed"/><ComboBoxItem Content="需要處理" Tag="attention"/>
            </ComboBox>
            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜尋檔名或來源" TextChanged="SearchChanged" AutomationProperties.Name="搜尋下載"/>
            <ComboBox x:Name="SortOrder" Grid.Column="2" SelectedIndex="0" SelectionChanged="StatusFilterChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="下載排序">
                <ComboBoxItem Content="最新加入" Tag="newest"/><ComboBoxItem Content="檔名 A–Z" Tag="name"/><ComboBoxItem Content="來源網站" Tag="source"/>
            </ComboBox>
            <Button x:Name="ClearCompletedButton" Grid.Column="3" Content="清除已完成" Click="ClearCompletedClick" ToolTipService.ToolTip="只清除紀錄，不刪除檔案"/>
        </Grid>
        <StackPanel x:Name="EmptyState" Grid.Row="2" Spacing="12" Padding="24" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="ms-appx:///Assets/Downlism.png" Width="56" Height="56" HorizontalAlignment="Center" AutomationProperties.Name="Downlism"/>
            <TextBlock x:Name="EmptyTitle" Text="還沒有下載" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
            <TextBlock x:Name="EmptyDescription" Text="貼上網址開始下載，也可以一次加入多個連結。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <ListView x:Name="Downloads" Grid.Row="2" SelectionMode="Extended" SelectionChanged="DownloadSelectionChanged" Padding="8,0,8,12" ScrollViewer.HorizontalScrollMode="Disabled" AutomationProperties.Name="下載清單">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="0"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadRowViewModel">
                    <Border BorderThickness="0,0,0,1" Padding="0,0,0,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid RowSpacing="9">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="124"/><ColumnDefinition Width="88"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind KindLabel}" Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(HasKindLabel)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind Size, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Speed, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind Remaining, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                    <Button Click="PauseClick" Tag="{x:Bind Id}" Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(CanPause), Mode=OneWay}" Style="{StaticResource RowActionButtonStyle}" AutomationProperties.Name="暫停" ToolTipService.ToolTip="暫停"><FontIcon Glyph="&#xE769;" FontSize="14"/></Button>
                                    <Button Click="ResumeClick" Tag="{x:Bind Id}" Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(CanResume), Mode=OneWay}" Style="{StaticResource RowActionButtonStyle}" AutomationProperties.Name="繼續" ToolTipService.ToolTip="繼續"><FontIcon Glyph="&#xE768;" FontSize="14"/></Button>
                                    <Button Click="HashClick" Tag="{x:Bind Id}" Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(IsFinished), Mode=OneWay}" Style="{StaticResource RowActionButtonStyle}" AutomationProperties.Name="計算 SHA-256" ToolTipService.ToolTip="計算並複製 SHA-256"><TextBlock Text="SHA" FontSize="11"/></Button>
                                    <Button Click="OpenFolderClick" Tag="{x:Bind Id}" Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(IsFinished), Mode=OneWay}" Style="{StaticResource RowActionButtonStyle}" AutomationProperties.Name="開啟位置" ToolTipService.ToolTip="開啟位置"><FontIcon Glyph="&#xE838;" FontSize="14"/></Button>
                                    <Button Click="RemoveClick" Tag="{x:Bind Id}" Style="{StaticResource RowActionButtonStyle}" AutomationProperties.Name="移除紀錄" ToolTipService.ToolTip="從清單移除，保留檔案"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
                                </StackPanel>
                            </Grid>
                            <controls:SegmentRibbon Grid.Row="1" Segments="{x:Bind Segments, Mode=OneWay}" Fraction="{x:Bind Fraction, Mode=OneWay}" Tone="{x:Bind Tone, Mode=OneWay}" Visibility="{x:Bind vm:DownloadRowViewModel.ShowIf(ShowProgress), Mode=OneWay}" HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Row="2" Text="{x:Bind Status, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="Summary" Grid.Row="3" Margin="20,0,20,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Window>
