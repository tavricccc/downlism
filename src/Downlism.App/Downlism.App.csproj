<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\docs\assets\downlism.ico</ApplicationIcon>
    <RootNamespace>Downlism.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Framework-dependent WinUI: the Windows App SDK comes from the shared MSIX framework
         package that the bootstrap launcher deploys, not from a copy inside every install.
         Three lism apps each carrying their own 145 MB of it is three copies on disk and,
         when more than one is open, three copies of the same code pages in memory. .NET
         itself stays self-contained — that one has no installer we are willing to chain. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Ships its own runtime. Without this the published app demands a matching .NET Desktop
         Runtime on the target machine, which is not something a download manager should make
         a person install first. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Downlism.Core\Downlism.Core.csproj" />
    <Content Include="..\..\docs\assets\downlism.ico" Link="Assets\Downlism.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\assets\downlism-icon-fluent.png" Link="Assets\Downlism.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
