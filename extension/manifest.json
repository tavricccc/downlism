{
  "manifest_version": 3,
  "name": "Downlism",
  "version": "0.2.0",
  "description": "把 Chrome 與 Edge 的下載交給 Downlism 接手。",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "downloads",
    "cookies",
    "nativeMessaging",
    "storage",
    "webRequest",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Downlism"
  },
  "icons": {
    "128": "icon128.png"
  }
}
